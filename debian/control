Source: giflib
Section: non-free/graphics
Priority: extra
Maintainer: Andreas Jellinghaus <aj@dungeon.inka.de>
Standards-Version: 2.3.0.0

Package: giflib3-dev
Architecture: any
Conflicts: giflib-dev, giflib3g-dev, libgif-dev, libgif3g-dev, libgif2-dev
Provides: giflib-dev
Depends: libc5-dev, giflib3 (= ${Source-Version})
Description: shared library for GIF images (development files)
 This package contains header files needed to compile programs that use
 giflib.                

Package: giflib-bin
Architecture: any
Conflicts: libgif3-bin
Depends: giflib3 (= ${Source-Version}), ${shlibs:Depends}
Description: programs to convert GIF images
 These are some programs that use giflib to convert images.

Package: giflib3
Architecture: any
Conflicts: libgif3g, libgif2
Depends: libc5
Description: shared library for GIF images (runtime lib)
 This is a shared library for working with GIF images. 

