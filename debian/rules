#!/usr/bin/make -f
# Made with the aid of debmake, by Christoph Lameter,
# based on the sample debian/rules file for GNU hello by Ian Jackson.

package=giflib

build:
	$(checkdir)
	
	make 

	touch build

clean:
	$(checkdir)
	-rm -f build
	-make clean
	-rm -f `find . -name "*~"`
	-rm -rf debian/tmp debian/giflib*/ debian/files* core debian/substvars

binary-indep:	checkroot build
	$(checkdir)
# There are no architecture-independent files to be uploaded
# generated by this package.  If there were any they would be
# made here.

binary-arch:	checkroot build
	$(checkdir)
	-rm -rf debian/tmp
	install -d debian/tmp
	mkdir -p debian/tmp/usr/lib
	mkdir -p debian/tmp/usr/bin
	mkdir -p debian/tmp/usr/include
	cp lib/*.h debian/tmp/usr/include
	mkdir -p debian/tmp/usr/doc/giflib3g/html
	cp doc/*.txt debian/tmp/usr/doc/giflib3g
	cp doc/*.html debian/tmp/usr/doc/giflib3g/html
	make install DESTDIR=`pwd`/debian/tmp/
	ln -s libgif.so.3 debian/tmp/usr/lib/libgif.so
	(cd debian/tmp/usr/doc; ln -s giflib3g giflib3g-dev)
	(cd debian/tmp/usr/doc; ln -s giflib3g giflib-bin)
# Must have debmake installed for this to work. Otherwise please copy
# /usr/bin/debstd into the debian directory and change debstd to debian/debstd
	debstd NEWS READ.ME
	dpkg-gencontrol -pgiflib3g
	chown -R root.root debian/tmp
	chmod -R go=rX debian/tmp
	dpkg --build debian/tmp ..

define checkdir
	test -f debian/rules
endef

# Below here is fairly generic really

binary:		binary-indep binary-arch

checkroot:
	$(checkdir)
	test root = "`whoami`"

.PHONY: binary binary-arch binary-indep clean checkroot
